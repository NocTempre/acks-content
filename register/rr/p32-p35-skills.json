    "effects": [
      {
        "type": "modifier",
        "target": "proficiencyThrow",
        "mode": "add",
        "forWhat": "Sneaking",
        "condition": "moving faster than one-half combat speed",
        "from": {
          "pattern": "greater\\s*than\\s*one-half\\s*combat\\s*speed,?\\s*he\\s*takes\\s*a\\s*(-\\d+)"
        },
        "note": "Exploration speed and one-half combat speed carry no penalty."
      },
      {
        "type": "modifier",
        "target": "proficiencyThrow",
        "mode": "add",
        "forWhat": "Sneaking",
        "condition": "running",
        "from": {
          "pattern": "If\\s*he\\s*runs,?\\s*he\\s*takes\\s*a\\s*(-\\d+)\\s*penalty"
        },
        "note": "Alternative to the faster-than-half-combat-speed penalty, not cumulative with it."
      },
      {
        "type": "modifier",
        "target": "surprise",
        "mode": "add",
        "appliesTo": "opponent",
        "condition": "thief outside their line of sight",
        "from": {
          "pattern": "suffer\\s*a\\s*(-\\d+)\\s*penalty\\s*to\\s*surprise"
        },
        "note": "Imposed on opponents encountering the thief, whether or not the Sneaking throw succeeded."
      },
      {
        "type": "capability",
        "condition": "while sneaking (throw succeeded)",
        "note": "The thief moves in total silence: even an alert creature that makes its Listening throw hears nothing."
      },
      {
        "type": "capability",
        "condition": "engaging an unengaged foe from the rear",
        "note": "Engaging an unengaged opponent from the rear while sneaking denies that opponent its free facing change."
      }
    ],
    "icon": "icons/svg/cowled.svg"
  },
